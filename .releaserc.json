{
  "branches": [
    {
      "name": "dev",
      "prerelease": true
    },
    {
      "name": "master"
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node scripts/set-version.js ${nextRelease.version}",
        "publishCmd": "cd packages/theme-core && bun publish --access public --tag ${nextRelease.channel || 'latest'} --no-git-checks && cd ../sdk && bun publish --access public --tag ${nextRelease.channel || 'latest'} --no-git-checks"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "LICENSE",
            "label": false
          }
        ]
      }
    ]
  ],
  "repositoryUrl": "https://github.com/PanoMC/sdk.git"
}
