{
  "sdkLine": "2.0.0",
  "branches": [
    {
      "name": "dev",
      "prerelease": true
    },
    {
      "name": "master"
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node scripts/set-version.js ${nextRelease.version}",
        "publishCmd": "bash scripts/publish-all.sh ${nextRelease.channel || 'latest'}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "LICENSE",
            "label": false
          }
        ]
      }
    ]
  ],
  "repositoryUrl": "https://github.com/PanoMC/sdk.git"
}
