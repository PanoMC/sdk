    "magic-string": "^1.4.3",
    "postcss": "^8.5.30",
    "rollup": "^4.64.7",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-svelte": "^7.2.3"
  },
  "peerDependencies": {
    "@panomc/sdk": "*",
    "svelte": "*"
  },
  "devDependencies": {
    "@panomc/sdk": "workspace:*",
    "bootstrap": "5.3.8",
    "happy-dom": "^21.0.1",
    "sass": "^1.105.1",
    "typescript": "^6.0.3"
  }
