{
  "name": "@panomc/plugin-kit",
  "version": "0.0.0-development",
  "description": "Build tooling for Pano plugins: the panoPlugin() rollup preset, the pano-plugin CLI and the controller core.",
  "author": "PanoMC",
  "license": "MIT",
  "type": "module",
  "repository": {
    "url": "https://github.com/PanoMC/sdk"
  },
  "exports": {
    ".": "./src/index.js",
    "./rollup": "./src/rollup/index.js",
    "./controller": "./src/controller/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
